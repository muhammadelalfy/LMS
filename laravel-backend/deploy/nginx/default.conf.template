# Rendered by the nginx image's envsubst step (only ${CENTRAL_HOST}, ${PUBLIC_IP}, ${ROOT_DOMAIN}).
#
# Cloudflare terminates TLS for visitors and connects here over HTTPS (port 443, Full strict)
# or HTTP (port 80). Both servers share site.inc. The visitor's real IP and scheme are taken
# from Cloudflare's headers only when the TCP peer is inside Cloudflare's published ranges.
#
# Every host opens on the Laravel landing page at `/`. School hosts
# (<school>.<base domain>) serve the web app for everything else (sign-in at
# /login), with API paths load-balanced across every `api` replica. The central
# host (and the bare IP) go to Laravel for everything: operator API, webhooks.

resolver 127.0.0.11 valid=10s ipv6=off;

# The default follows the CPU cache line (32 on some hosts), too small for long hostnames.
map_hash_bucket_size 128;

log_format lb '$remote_addr $host "$request" $status $body_bytes_sent '
              'upstream=$upstream_addr rt=$request_time urt=$upstream_response_time';
access_log /var/log/nginx/access.log lb;

# Visitor IP: believe CF-Connecting-IP only from Cloudflare. Anyone else reaching the origin
# directly cannot choose the address that rate limits and logs see.
include /etc/nginx/templates/cloudflare-ips.inc;
real_ip_header CF-Connecting-IP;

geo $realip_remote_addr $from_cloudflare {
    default 0;
    include /etc/nginx/templates/cloudflare-geo.inc;
}

# Server lists live in upstreams/*.inc. Normally they name the compose service (every
# replica, re-resolved every 10 s); deploy.sh rewrites them to exact containers while it
# rolls replicas, so traffic moves with a graceful reload instead of racing DNS.
upstream api {
    zone api 64k;
    least_conn;
    include /etc/nginx/templates/upstreams/api.inc;
    keepalive 32;
}

upstream reverb {
    zone reverb 64k;
    server reverb:8080 resolve;
}

upstream web {
    zone web 64k;
    include /etc/nginx/templates/upstreams/web.inc;
    keepalive 8;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The scheme Laravel should see: the one Cloudflare reports, else the one this connection used.
map "$from_cloudflare:$http_x_forwarded_proto" $forwarded_proto {
    default            $scheme;
    "~^1:(?<proto>https?)$" $proto;
}

# Hosts with no school behind them (operator API, landing page, webhooks) go to Laravel. The apex
# and www of the root domain are central too; ROOT_DOMAIN is a placeholder that matches nothing
# when no root domain is configured.
map $host $site_upstream {
    hostnames;
    default              web;
    ${CENTRAL_HOST}      api;
    ${PUBLIC_IP}         api;
    ${ROOT_DOMAIN}       api;
    www.${ROOT_DOMAIN}   api;
}

server {
    listen 80 default_server;
    server_name _;
    include /etc/nginx/templates/site.inc;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/templates/site.inc;
}
