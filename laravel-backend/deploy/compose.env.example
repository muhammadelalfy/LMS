# Copy to deploy/.env (read by docker compose for ${...} interpolation).
# CI rewrites API_IMAGE / WEB_IMAGE on each deploy; roll back by setting a previous tag.
API_IMAGE=mudarisy-api:local
WEB_IMAGE=mudarisy-web:local
API_REPLICAS=3
HTTP_PORT=80
# Host that serves the central app (operator API, landing page, webhooks).
CENTRAL_HOST=api.mudarisy.localhost
# The server's public IP also routes to the central app.
PUBLIC_IP=127.0.0.1
# An existing school host that deploy.sh smoke-tests after every rollout.
SMOKE_SCHOOL_HOST=demo.mudarisy.localhost
